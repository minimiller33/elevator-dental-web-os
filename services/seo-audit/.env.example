# Generate a shared secret; configure the same value in Cloudflare Workers.
SEO_SERVICE_TOKEN=
RESEND_API_KEY=
# Use an address on a domain verified in Resend.
RESEND_FROM=Elevator Dental <soporte@elevatordental.com>
PUBLIC_SITE_URL=https://elevatordental.com
DAILY_JOB_LIMIT=50
# Direct GHL contact integration (contacts.readonly and contacts.write).
GHL_API_TOKEN=
GHL_LOCATION_ID=
# Optional alternative dedicated GHL workflow (premium trigger).
GHL_SEO_WEBHOOK_URL=
